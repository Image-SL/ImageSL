# Secrets
.env
*.key

# Python
__pycache__/
# NOT *.py[cod] — that bracket also matches .pyd, which is a compiled extension
# module, not a build artefact. It silently stripped every C extension out of a
# committed PyInstaller build; the result installed fine and died on launch with
# "No module named '_socket'".
*.py[co]
.venv/
venv/
*.egg-info/

# Client build artifacts
*.pdb

# Desktop packaging output (PyInstaller writes these; CI rebuilds them)
/build/
/dist/
/ImageSL.iconset/
desktop/ImageSL.icns
ImageSL-Setup-Windows.exe
ImageSL-macOS.dmg

# Node / misc
node_modules/
.DS_Store
Thumbs.db

# Large local sample slides (keep the repo light)
*.svs
samples/*.tif
samples/*.tiff

# Built installers served by /download/<platform>. Populated at deploy time;
# an 82MB binary does not belong in git.
/downloads/
