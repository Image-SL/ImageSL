# ---- ImageSL backend configuration -----------------------------------------
# Copy to .env for local dev, and set the same variables in the Railway
# service "Variables" tab for production. NEVER commit real secrets.

# Claude API key — powers the AI vision reasoning and the in-app chatbot.
# Without it, the app still analyzes slides; AI features degrade gracefully.
ANTHROPIC_API_KEY=

# Which Claude model to use (defaults shown). Vision + chat.
IMAGESL_CLAUDE_MODEL=claude-opus-4-8
IMAGESL_VISION_MODEL=claude-opus-4-8

# Comma-separated license keys. If set, every /api/* call must send a matching
# X-ImageSL-Key header (the desktop client passes the user's license key).
# Leave blank to run open (development only).
IMAGESL_ACCESS_TOKENS=

# Path (inside the container) to the published Windows client for /download/windows.
IMAGESL_CLIENT_EXE=/app/dist/ImageSL.exe

# Max upload size in MB and default analysis resolution cap (long edge, px).
IMAGESL_MAX_UPLOAD_MB=256

# App version string shown in /api/health.
IMAGESL_VERSION=1.0.0
