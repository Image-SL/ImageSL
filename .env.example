# ---- ImageSL backend configuration -----------------------------------------
# Copy to .env for local dev. In production these are set in the container
# `environment` block of .github/workflows/deploy.yml, which is the file that
# actually decides what the live service runs — editing them anywhere else has
# no effect on the deploy.
#
# Every variable below is read by the code. Nothing here is aspirational.

# Version string reported by /api/health and /api/downloads.
IMAGESL_VERSION=2.0.0

# Max upload size in MB.
IMAGESL_MAX_UPLOAD_MB=256

# How many slides may be measured at once. A slide is about a second of numpy on
# a full core, so this wants to track the container's vCPU count, not exceed it.
IMAGESL_MAX_CONCURRENCY=2

# Analysis cache: how many analyses to hold, their total budget in MB, and how
# long a genuinely idle one survives (seconds; 28800 = 8 hours). The page sends a
# heartbeat, so an open batch is not aged out from under a long review session.
IMAGESL_CACHE_MAX=400
IMAGESL_CACHE_MB=6144
IMAGESL_CACHE_TTL=28800

# Comma-separated license keys. If set, every /api/* call must send a matching
# X-ImageSL-Key header. Leave blank to run open (development only).
IMAGESL_ACCESS_TOKENS=

# ---- Desktop installer downloads -------------------------------------------
# Two ways to serve /download/<platform>; an external URL wins where both exist.
#
# 1. From this app's own disk. Put ImageSL-Setup-Windows.exe and
#    ImageSL-macOS.dmg in this directory under exactly those names.
#    NOTE the default differs between a source checkout and the container: the
#    Dockerfile copies server/ to /app, so BASE_DIR.parent is the filesystem
#    root and the default resolves to /downloads, not /app/downloads. Set this
#    explicitly rather than relying on the default.
IMAGESL_DOWNLOAD_DIR=

# 2. Off-box. A build is ~86MB and is not in git, so on a hosted deploy it lives
#    in object storage instead. Set these and /download/<platform> 302s there,
#    which also keeps 86MB per download off this app's bandwidth.
IMAGESL_DOWNLOAD_URL_WINDOWS=
IMAGESL_DOWNLOAD_URL_MACOS=

# 3. What version those installers ARE. build-desktop.yml's publish job writes a
#    plain-text VERSION next to them; point this at it and /api/downloads reports
#    it as `version` (this server's own becomes `server_version`).
#
#    This is the number desktop/updater.py compares against to decide whether to
#    offer an update, and it has to come from whatever published the installers.
#    Left unset, /api/downloads answers with the server's version instead -- fine
#    locally, where the two are the same tree, but on a hosted deploy they are
#    built by different workflows on different triggers and a release that rolls
#    out the server without the installers would offer an update that is not
#    there.
IMAGESL_DOWNLOAD_VERSION_URL=

# ---- Set by the desktop launcher, not by you -------------------------------
# IMAGESL_DESKTOP=1   makes "/" open the analyzer instead of the landing page.
# IMAGESL_SITE        where the desktop app points its "on the web" links.
